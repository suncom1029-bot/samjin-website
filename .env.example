# ======================== API 설정 ========================
# Finnhub API KEY (무료 가입: https://finnhub.io/)
# - 무료 계정: 1분당 60요청 제한, 하지만 충분함
# - 가입 후 대시보드에서 API KEY 복사
FINNHUB_API_KEY=your_finnhub_api_key_here

# DART API KEY (선택사항, 재무정보 자동 조회용)
# - DART 공개 API: https://open.dart.fss.or.kr/
# - 가입 후 API KEY 발급
DART_API_KEY=your_dart_api_key_here

# ======================== 캐싱 설정 ========================
# API 응답 캐싱 시간 (초)
API_CACHE_TTL=300

# ======================== 환경 ========================
# development / production
APP_ENV=development
